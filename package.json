{
  "name": "elayabath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ingest": "node scripts/ingest/index.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/audit/static.ts",
    "audit:browser": "node scripts/audit/browser.ts",
    "db:start": "supabase start -x realtime,edge-runtime,logflare,vector,supavisor,imgproxy",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed/index.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "exceljs": "^4.4.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "supabase": "^2.117.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
