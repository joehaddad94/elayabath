# Copy to .env.local and fill in. .env.local is gitignored; never commit keys.
#
# Local development: run `npx supabase start`, then `npx supabase status -o env`
# prints every value below except BOOTSTRAP_STAFF_EMAIL.

# Where Supabase is. Public by design: both ship to every visitor's browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The service key. Bypasses row-level security. Server only: used by direct
# sign-in, the seed and the nightly job. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# The first staff member, added by the seed. Never written into a migration.
BOOTSTRAP_STAFF_EMAIL=

# Sign-in mode. Leave unset while no email provider is configured: staff on
# the list sign in directly. Set to "link" once Supabase Auth has a real SMTP
# provider, and sign-in becomes a magic link.
ADMIN_SIGN_IN=
